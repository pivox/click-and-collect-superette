# syntax=docker/dockerfile:1
#
# Kadhia frontend — production image (Next.js 14, standalone output).
#
# Build context is apps/frontend/ (see docker-compose.prod.yml).
#
# ⚠ THE SIX NEXT_PUBLIC_* VALUES ARE BAKED INTO THE JAVASCRIPT BUNDLE AT BUILD
# TIME. Next.js replaces every `process.env.NEXT_PUBLIC_*` occurrence with a
# literal during `next build`; setting them in docker-compose `environment:`
# has NO effect on the shipped bundle. They are therefore build arguments, and
# the guard below refuses to produce an image when the dangerous ones are wrong.

# ──────────────────────────────────────────────────────────────────────────────
# Stage 1 — dependencies
# ──────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS deps

WORKDIR /app

# npm ci requires the lockfile and installs devDependencies too: next build
# needs typescript, tailwindcss and postcss.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# ──────────────────────────────────────────────────────────────────────────────
# Stage 2 — build
# ──────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_USE_MOCKS
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_APP_VERSION
ARG NEXT_PUBLIC_ENVIRONMENT
ARG NEXT_PUBLIC_VAPID_PUBLIC_KEY

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_USE_MOCKS=${NEXT_PUBLIC_USE_MOCKS} \
    NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL} \
    NEXT_PUBLIC_APP_VERSION=${NEXT_PUBLIC_APP_VERSION} \
    NEXT_PUBLIC_ENVIRONMENT=${NEXT_PUBLIC_ENVIRONMENT} \
    NEXT_PUBLIC_VAPID_PUBLIC_KEY=${NEXT_PUBLIC_VAPID_PUBLIC_KEY}

# Fail the build loudly instead of shipping a production bundle that serves
# in-memory fixtures. src/lib/services/index.ts reads:
#     (process.env.NEXT_PUBLIC_USE_MOCKS ?? "1") !== "0"
# so BOTH an unset variable AND an empty string mean "use mocks" — an empty
# string is not nullish, so the ?? "1" fallback does not even apply. Only the
# exact string "0" disables the mocks.
RUN set -eu; \
    fail=0; \
    if [ "${NEXT_PUBLIC_USE_MOCKS}" != "0" ]; then \
        echo "FATAL: NEXT_PUBLIC_USE_MOCKS must be exactly \"0\" for a production build (got: '${NEXT_PUBLIC_USE_MOCKS}')." >&2; \
        echo "       Any other value — including unset or empty — ships the in-memory mock data." >&2; \
        fail=1; \
    fi; \
    if [ -z "${NEXT_PUBLIC_API_URL}" ]; then \
        echo "FATAL: NEXT_PUBLIC_API_URL is empty; the bundle would fall back to http://localhost:8000." >&2; \
        fail=1; \
    fi; \
    if [ -z "${NEXT_PUBLIC_APP_URL}" ]; then \
        echo "FATAL: NEXT_PUBLIC_APP_URL is empty; merchant QR codes would encode the browser origin instead of the public domain." >&2; \
        fail=1; \
    fi; \
    if [ -z "${NEXT_PUBLIC_ENVIRONMENT}" ]; then \
        echo "FATAL: NEXT_PUBLIC_ENVIRONMENT is empty; client log shipping stays in dev mode." >&2; \
        fail=1; \
    fi; \
    case "${NEXT_PUBLIC_API_URL}${NEXT_PUBLIC_APP_URL}" in \
        *localhost*|*127.0.0.1*) \
            echo "WARNING: NEXT_PUBLIC_API_URL / NEXT_PUBLIC_APP_URL point at localhost — fine for a local smoke test, wrong for a real deployment." >&2 ;; \
    esac; \
    if [ -z "${NEXT_PUBLIC_VAPID_PUBLIC_KEY}" ]; then \
        echo "WARNING: NEXT_PUBLIC_VAPID_PUBLIC_KEY is empty — Web Push subscription will throw on the client (S14-003)." >&2; \
    fi; \
    [ "$fail" -eq 0 ]

# @ducanh2912/next-pwa generates public/sw.js, public/workbox-*.js and
# public/worker-*.js during this build (from worker/index.ts).
RUN npm run build

# ──────────────────────────────────────────────────────────────────────────────
# Stage 3 — runner
# ──────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# .next/standalone already contains server.js and the traced node_modules, but
# neither the static assets nor public/ — Next.js documents both as a manual
# copy. public/ is taken from the build stage (not from the source) so the
# service worker generated above is included.
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public

# node:alpine ships a non-root `node` user (uid 1000); no need to create one.
USER node

EXPOSE 3000

CMD ["node", "server.js"]
