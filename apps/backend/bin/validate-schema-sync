#!/usr/bin/env php
<?php

declare(strict_types=1);

$command = [PHP_BINARY, 'bin/console', 'doctrine:schema:update', '--dump-sql', '--no-interaction', '--no-ansi'];

$descriptors = [
    1 => ['pipe', 'w'],
    2 => ['pipe', 'w'],
];

$process = proc_open($command, $descriptors, $pipes);
if (!\is_resource($process)) {
    fwrite(STDERR, "Unable to start Doctrine schema diff.\n");
    exit(1);
}

$stdout = stream_get_contents($pipes[1]);
$stderr = stream_get_contents($pipes[2]);
fclose($pipes[1]);
fclose($pipes[2]);

$status = proc_close($process);
if (0 !== $status) {
    fwrite(STDERR, $stderr);
    exit($status);
}

$normalizedStdout = preg_replace('/\e\[[\d;]*m/', '', $stdout) ?? $stdout;
if (
    false !== stripos($normalizedStdout, 'Nothing to update')
    && 1 !== preg_match('/;\s*$/m', $normalizedStdout)
) {
    echo "[OK] Doctrine schema is in sync.\n";
    exit(0);
}

$statements = array_values(array_filter(
    array_map('trim', preg_split('/\R/', $normalizedStdout) ?: []),
    static fn (string $line): bool => '' !== $line,
));

$allowedPatterns = [
    '/^DROP SEQUENCE billing_document_number_seq CASCADE;$/',
    '/^DROP TABLE messenger_worker_state;$/',
    '/^DROP INDEX idx_subscriptions_(created_at|pricing_phase|lifecycle);$/',
    '/^DROP INDEX idx_messenger_messages_(available_at|delivered_at|queue_name|queue_available);$/',
    '/^ALTER INDEX idx_subscription_payment_reminders_(subscription|admin) RENAME TO IDX_[A-F0-9]+;$/',
    '/^ALTER INDEX idx_subscription_payments_(created_by_admin|validated_by_admin) RENAME TO IDX_[A-F0-9]+;$/',
    '/^ALTER INDEX uniq_merchant_invitation_token_hash RENAME TO UNIQ_[A-F0-9]+;$/',
    '/^ALTER INDEX idx_merchant_invitation_created_by RENAME TO IDX_[A-F0-9]+;$/',
    '/^ALTER INDEX uniq_merchant_crm_profiles_merchant RENAME TO UNIQ_[A-F0-9]+;$/',
    '/^ALTER INDEX uniq_product_groups_slug RENAME TO UNIQ_[A-F0-9]+;$/',
    '/^ALTER TABLE messenger_messages ALTER id DROP DEFAULT;$/',
    '/^ALTER TABLE messenger_messages ALTER id ADD GENERATED BY DEFAULT AS IDENTITY;$/',
    '/^ALTER INDEX idx_messenger_messages_queue_available RENAME TO IDX_[A-F0-9]+;$/',
    '/^ALTER TABLE product_pack_items ALTER quantity DROP DEFAULT;$/',
    '/^ALTER TABLE product_packs ALTER is_active DROP DEFAULT;$/',
    '/^ALTER TABLE push_subscriptions ALTER failure_count DROP DEFAULT;$/',
    '/^ALTER TABLE merchant_crm_profiles ALTER status DROP DEFAULT;$/',
    '/^ALTER TABLE product_groups ALTER (market_country|status|visibility) DROP DEFAULT;$/',
    '/^ALTER TABLE product_group_items ALTER importance DROP DEFAULT;$/',
    '/^COMMENT ON COLUMN (subscriptions|subscription_payment_reminders|subscription_payments|billing_documents|incidents|product_packs|product_pack_items|incident_notes|messenger_messages|merchant_crm_profiles|merchant_crm_contacts|product_groups|product_group_items|customer_product_favorites|feedback_entries|feedback_settings|kadhia_members|kadhia_share_links)\.[a-z_]+ IS \'\';$/',
];

$allowedPairedPatterns = [
    [
        '/^DROP INDEX uniq_kadhia_share_links_active_kadhia;$/',
        '/^CREATE UNIQUE INDEX UNIQ_KADHIA_SHARE_LINKS_ACTIVE_KADHIA ON kadhia_share_links \(kadhia_id\) WHERE active = true;$/',
    ],
    [
        '/^DROP INDEX uniq_merchant_invitation_pending_merchant;$/',
        '/^CREATE UNIQUE INDEX UNIQ_MERCHANT_INVITATION_PENDING_MERCHANT ON merchant_invitation_tokens \(merchant_id\) WHERE used_at IS NULL AND revoked_at IS NULL;$/',
    ],
];

$matchesAnyStatement = static function (string $pattern) use ($statements): bool {
    foreach ($statements as $statement) {
        if (1 === preg_match($pattern, $statement)) {
            return true;
        }
    }

    return false;
};

$unexpected = [];
foreach ($statements as $statement) {
    $isAllowed = false;
    foreach ($allowedPatterns as $pattern) {
        if (1 === preg_match($pattern, $statement)) {
            $isAllowed = true;
            break;
        }
    }

    if (!$isAllowed) {
        foreach ($allowedPairedPatterns as [$dropPattern, $createPattern]) {
            $matchesKnownPair = 1 === preg_match($dropPattern, $statement)
                || 1 === preg_match($createPattern, $statement);
            if (
                $matchesKnownPair
                && $matchesAnyStatement($dropPattern)
                && $matchesAnyStatement($createPattern)
            ) {
                $isAllowed = true;
                break;
            }
        }
    }

    if (!$isAllowed) {
        $unexpected[] = $statement;
    }
}

if ([] !== $unexpected) {
    fwrite(STDERR, "Unexpected Doctrine schema diff detected:\n");
    foreach ($unexpected as $statement) {
        fwrite(STDERR, "- {$statement}\n");
    }
    exit(1);
}

echo "[OK] Doctrine schema sync contains only known technical diffs.\n";
